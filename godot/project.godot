; Aurora Drift — native Godot 4.3+ build
;
; Renderer: Forward+ (Vulkan). This is what buys us the things WebGL2 could not
; do: automatic mesh LOD, occlusion culling, clustered lighting with many
; real-time lights, SDFGI/SSAO/SSR, and threaded resource loading.
;
; Tuned for a 6 GB RTX 4050 / Ryzen 7 7435HS / 24 GB target.

config_version=5

[application]

config/name="Aurora Drift"
config/description="First-person sci-fi space exploration. Explore the survey vessel Aurora Drift, fly 6-DOF, warp across the system, and land on the jungle world Ilex Prime."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.027, 0.047, 1)
boot_splash/show_image=false

[autoload]

GameState="*res://scripts/core/game_state.gd"
Assets="*res://scripts/assets/asset_registry.gd"
Palette="*res://scripts/assets/palette.gd"
Audio="*res://scripts/core/audio.gd"
Interact="*res://scripts/systems/interaction.gd"
ShipLayout="*res://scripts/world/ship_layout.gd"

[audio]

buses/default_bus_layout=""
driver/enable_input=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

