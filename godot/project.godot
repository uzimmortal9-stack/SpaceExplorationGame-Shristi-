[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="ship"

[physics]

common/max_physics_steps_per_frame=4
3d/default_gravity=18.5

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/texture_mipmap_bias=-0.3
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.02, 0.027, 0.047, 1)
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0
