+    const moon = new Mesh(
+      new SphereGeometry(110, 28, 20),
+      new MeshBasicMaterial({ color: 0xc7d4dd, fog: false, transparent: true, opacity: 0.72, depthWrite: false }),
+    );
+    moon.position.set(-880, 620, -1100);
+    this.group.add(moon);
