+		torus.outer_radius = 0.22
+		wheel.mesh = torus
+		var wmat := StandardMaterial3D.new()
+		wmat.albedo_color = Color(0.753, 0.443, 0.227)
+		wmat.metallic = 0.95
+		wmat.roughness = 0.3
