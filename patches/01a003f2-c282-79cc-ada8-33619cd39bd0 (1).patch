+
+  // airlock warning beacons
+  const beacons: Mesh[] = [];
+  for (const sx of [-1, 1]) {
+    const b = new Mesh(new SphereGeometry(0.09, 12, 10), mats.accent(PALETTE.warn, 0.6));
+    b.position.set(cx + sx * (RAMP_WIDTH / 2 + 0.7), 2.6, room.z1 - 0.4);
