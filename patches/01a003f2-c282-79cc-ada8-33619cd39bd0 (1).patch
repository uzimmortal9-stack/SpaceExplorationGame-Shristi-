+				GameState.push_systems()
+				extracting[0] = 0.0
+		var lvl: float = 0.35 + GameState.systems["fuel"] * 0.65
+		for f in fluids:
+			f.scale.y = lerpf(f.scale.y, lvl, 1.0 - pow(0.01, delta))
