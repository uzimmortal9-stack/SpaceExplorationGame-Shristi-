+  ], 1.5, 0.76, 0.85);
+
+  interact.register({
+    id: 'suit_up',
+    position: new Vector3(room.x0 + 2.0, 1.3, cz - 1.2),
+    radius: 2.4,
+    kind: 'use',
+    label: 'Don EVA suit',
+    onUse: () => {
+      state.suitOn = !state.suitOn;
+      audio.noiseBurst({ duration: 1.2, gain: 0.2, filter: 500, filterEnd: 1800, attack: 0.25 });
