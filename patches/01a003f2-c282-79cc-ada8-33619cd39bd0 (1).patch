+    // --------------------------------------------------------------- skydome
+    const sky = new Mesh(
+      new SphereGeometry(1800, 40, 26),
+      new MeshBasicMaterial({ color: 0x7fc6d8, side: BackSide, fog: false, depthWrite: false }),
