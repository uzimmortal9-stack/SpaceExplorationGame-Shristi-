+
+  // rotating conduits around the core
+  const conduits: Mesh[] = [];
+  for (let i = 0; i < 6; i++) {
+    const a = (i / 6) * Math.PI * 2;
+    const rod = new Mesh(new CylinderGeometry(0.075, 0.075, 3.2, 10), mats.brushed);
+    rod.position.set(Math.cos(a) * 1.28, 2.16, Math.sin(a) * 1.28);
